rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Trusted reviewers. The admin custom claim must be assigned by trusted
    // server-side code. A client cannot grant itself this claim.
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // users/{uid}
    // A role is written at signup and remains immutable.
    match /users/{uid} {
      allow read: if isSelf(uid);

      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role in ['user', 'pandit'];

      allow update: if isSelf(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.uid == resource.data.uid;

      allow delete: if false;
    }

    // TEMPORARY MVP BEHAVIOR: new Pandit profiles are approved at signup.
    // Before production, restore admin/backend-only approval.
    match /pandits/{uid} {
      // Signed-in users can view approved/pending profiles.
      allow read: if signedIn();

      // A Pandit can create only their own pending profile.
      // reviewCount and totalRating are optional for compatibility with
      // existing clients; if supplied at creation, they must both be zero.
      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.profileComplete == true
        && request.resource.data.verificationStatus == 'approved'
        && request.resource.data.rating == 0
        && request.resource.data.availability == 'offline'
        && (!('reviewCount' in request.resource.data)
          || request.resource.data.reviewCount == 0)
        && (!('totalRating' in request.resource.data)
          || request.resource.data.totalRating == 0)
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'city', 'specialization', 'experience', 'languages',
          'ratePerMinute', 'bio', 'rating', 'reviewCount', 'totalRating',
          'availability', 'verificationStatus', 'profileComplete', 'updatedAt'
        ]);

      // Admins may update Pandit profile, verification and aggregate rating
      // fields. Only trusted admin accounts should have the admin custom claim.
      allow update: if (
          isAdmin()
          && request.resource.data.keys().hasOnly([
            'uid', 'name', 'city', 'specialization', 'experience', 'languages',
            'ratePerMinute', 'bio', 'rating', 'reviewCount', 'totalRating',
            'availability', 'verificationStatus', 'profileComplete', 'updatedAt'
          ])
        )
        || (
          isSelf(uid)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.verificationStatus == resource.data.verificationStatus
          && request.resource.data.rating == resource.data.rating
          // Prevent Pandit clients from changing review aggregates.
          // Defaults keep older Pandit documents without these fields usable.
          && request.resource.data.get('reviewCount', 0)
            == resource.data.get('reviewCount', 0)
          && request.resource.data.get('totalRating', 0)
            == resource.data.get('totalRating', 0)
          && request.resource.data.keys().hasOnly([
            'uid', 'name', 'city', 'specialization', 'experience', 'languages',
            'ratePerMinute', 'bio', 'rating', 'reviewCount', 'totalRating',
            'availability', 'verificationStatus', 'profileComplete', 'updatedAt'
          ])
        );

      allow delete: if false;

      // pandits/{uid}/reviews/{reviewId}
      // Clients can read reviews, but only trusted Cloud Functions (Admin SDK)
      // can create, update or delete them.
      match /reviews/{reviewId} {
        allow read: if signedIn();
        allow create, update, delete: if false;
      }
    }

    // consultations/{callId}
    // Existing consultation state and participant permissions are preserved.
    match /consultations/{callId} {
      function isCallParticipant() {
        return signedIn()
          && (resource.data.userId == request.auth.uid
            || resource.data.panditId == request.auth.uid);
      }

      allow read: if isCallParticipant();

      // Only an existing, approved Pandit can be requested, unpaid and at
      // the initial state of the consultation lifecycle.
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'REQUESTED'
        && request.resource.data.mode in ['chat', 'audio', 'video']
        && request.resource.data.amountPaid == 0
        && request.resource.data.refundAmount == 0
        && get(/databases/$(database)/documents/pandits/$(request.resource.data.panditId)).data.verificationStatus == 'approved'
        && request.resource.data.keys().hasOnly([
          'userId', 'panditId', 'status', 'mode', 'amountPaid',
          'refundAmount', 'connectedAt', 'endedAt', 'createdAt', 'updatedAt'
        ]);

      allow update: if isCallParticipant()
        && request.resource.data.keys().hasOnly([
          'userId', 'panditId', 'status', 'mode', 'amountPaid',
          'refundAmount', 'connectedAt', 'endedAt', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'connectedAt', 'endedAt', 'updatedAt'
        ]);

      allow delete: if false;

      // messages/{messageId}
      match /messages/{messageId} {
        function parentCall() {
          let call = get(/databases/$(database)/documents/consultations/$(callId)).data;
          return signedIn()
            && (call.userId == request.auth.uid
              || call.panditId == request.auth.uid);
        }

        allow read: if parentCall();

        allow create: if parentCall()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.type == 'text'
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.keys().hasOnly([
            'senderId', 'text', 'type', 'createdAt', 'readAt'
          ]);

        // The only client edit is marking a message as read.
        allow update: if parentCall()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'readAt'
          ]);

        allow delete: if false;
      }
    }

    // transactions/{txnId}
    // Written only by trusted Cloud Functions; clients are read-only.
    match /transactions/{txnId} {
      allow read: if isSelf(resource.data.userId);
      allow write: if false;
    }

    // Everything else remains locked until its owning feature defines rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
